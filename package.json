{
  "name": "apparel-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "supabase:check": "node --conditions=react-server --import tsx scripts/check-supabase.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:link": "supabase link",
    "supabase:migration:new": "supabase migration new",
    "supabase:migration:list": "supabase migration list",
    "supabase:db:push": "supabase db push",
    "supabase:db:reset": "supabase db reset",
    "test:db": "node --import tsx scripts/test-database.ts",
    "supabase:remote:list": "node --conditions=react-server --import tsx scripts/manage-database.ts list",
    "supabase:remote:plan": "node --conditions=react-server --import tsx scripts/manage-database.ts plan",
    "supabase:remote:push": "node --conditions=react-server --import tsx scripts/manage-database.ts push",
    "supabase:schema:verify": "node --conditions=react-server --import tsx scripts/manage-database.ts verify",
    "supabase:types": "node --conditions=react-server --import tsx scripts/manage-database.ts types",
    "bootstrap:users": "node --conditions=react-server --import tsx scripts/bootstrap-users.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "shadcn": "4.21.3",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
