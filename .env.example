# Documentation only: no variables are read by the G01 application.
# Future G02 cookie-based Supabase SSR integration:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# SERVER ONLY — NEVER PREFIX AS PUBLIC — NEVER EXPOSE TO BROWSER.
# Future backend transactional commands and Auth Admin API only.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
