# Public configuration for browser Auth and user-context server clients.
# Copy to ignored .env.local and replace placeholders with project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SERVER ONLY — NEVER PREFIX AS PUBLIC — NEVER EXPOSE TO BROWSER.
# Privileged backend/Auth Admin adapter only; never user-context reads.
SUPABASE_SECRET_KEY=your-server-only-secret-key
# For a legacy project, use its anon key as the publishable-key value and
# its service_role key as the secret-key value. Never make that credential PUBLIC.
# CLI access tokens/database passwords are separate; never store them in Git.
# Optional operator tooling (never NEXT_PUBLIC, not needed by the application):
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_URL=postgresql://postgres@db.your-project.supabase.co:5432/postgres
# Existing ignored db_password is supported as a legacy password variable.

# Exact trusted application origin; HTTPS for deployment, no trailing slash.
APP_ORIGIN=http://localhost:3000
# Server-only controlled evaluator accounts. No NEXT_PUBLIC credentials.
DEMO_ACCOUNTS_ENABLED=false
# DEMO_CUTTING_SUPERVISOR_EMAIL=your-controlled-demo-email
# DEMO_CUTTING_SUPERVISOR_PASSWORD=your-private-demo-password
# DEMO_CUTTING_VERIFIER_EMAIL=your-controlled-demo-email
# DEMO_CUTTING_VERIFIER_PASSWORD=your-private-demo-password
# DEMO_SEWING_SUPERVISOR_EMAIL=your-controlled-demo-email
# DEMO_SEWING_SUPERVISOR_PASSWORD=your-private-demo-password
# BOOTSTRAP_ADMIN_EMAIL=your-private-admin-email
# BOOTSTRAP_ADMIN_FULL_NAME=your-admin-name
# BOOTSTRAP_ADMIN_PASSWORD=your-private-strong-admin-password
